{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "1fc98020e9b458f22c56f51a11518116",
    "m_Title": "Como leer este grafo",
    "m_Content": "Pulsa A para ver todo el grafo (F centra la seleccion).\nLos datos viajan de IZQUIERDA a DERECHA hasta el Master Stack (a la derecha del todo).\nCada recuadro numerado es un PASO; la nota amarilla de su izquierda lo explica.\nLos circulos/cuadros dentro de los nodos son vistas previas del valor en ese punto.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -330.0,
        "y": -540.0,
        "width": 700.0,
        "height": 330.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "10462e439e4a9f54ea9000b623fdc9cf",
    "m_Title": "2 \u00b7 Distancia al centro",
    "m_Content": "UV - 0.5 centra el origen. Multiplicamos X por la proporcion de pantalla (Screen: ancho/alto) para que sea circulo y no ovalo.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 280.0,
        "width": 380.0,
        "height": 290.0
    },
    "m_Group": {
        "m_Id": "320b9ec5c3a1ebc5480db144cc211553"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "8923078dbdb95b165779e84f0439028e",
    "m_Title": "3 \u00b7 Borde suave",
    "m_Content": "Smoothstep(radio - suavidad, radio, distancia): 0 al centro, 1 en el borde.",
    "m_TextSize": 1,
    "m_Theme": 0,
