{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "061a5a2b0241273a0a36bb603924b044",
    "m_Title": "Como leer este grafo",
    "m_Content": "Pulsa A para ver todo el grafo (F centra la seleccion).\nLos datos viajan de IZQUIERDA a DERECHA hasta el Master Stack (a la derecha del todo).\nCada recuadro numerado es un PASO; la nota amarilla de su izquierda lo explica.\nLos circulos/cuadros dentro de los nodos son vistas previas del valor en ese punto.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -330.0,
        "y": -540.0,
        "width": 700.0,
        "height": 330.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "4a1014639f9e71b0d453dd1bd3a391ab",
    "m_Title": "1 \u00b7 Curvar la pantalla",
    "m_Content": "UV -1..1; las empujamos hacia afuera mas cuanto mas lejos del centro (dot(c,c)).",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 0.0,
        "width": 380.0,
        "height": 234.0
    },
    "m_Group": {
        "m_Id": "b711c81e54fc7b337f8b18f076cec02d"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "2f119180b28dea210e060310012c113b",
    "m_Title": "2 \u00b7 Fuera de la pantalla = negro",
    "m_Content": "Cuatro Step multiplicados valen 1 solo si la UV esta dentro de 0..1.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 460.0,
        "width": 380.0,
        "height": 234.0
    },
    "m_Group": {
        "m_Id": "7b9fbf40e365bc5cbc8875e709f74c43"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "f98fb7c70b66d84e4b460bbefeae8157",
    "m_Title": "3 \u00b7 Sangrado RGB",
    "m_Content": "Rojo y azul se leen un poco desplazados en X: franjas de color como en un CRT.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 1190.0,
        "width": 380.0,
        "height": 234.0
    },
    "m_Group": {
        "m_Id": "c4e8138e44aea02a2c7d2a3bf72a43f6"
    }
}

{
