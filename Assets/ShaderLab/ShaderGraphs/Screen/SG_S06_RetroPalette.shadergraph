{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "636dd98d20cbb7dc601850755b624a8f",
    "m_Title": "Como leer este grafo",
    "m_Content": "Pulsa A para ver todo el grafo (F centra la seleccion).\nLos datos viajan de IZQUIERDA a DERECHA hasta el Master Stack (a la derecha del todo).\nCada recuadro numerado es un PASO; la nota amarilla de su izquierda lo explica.\nLos circulos/cuadros dentro de los nodos son vistas previas del valor en ese punto.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -330.0,
        "y": -540.0,
        "width": 700.0,
        "height": 330.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "fb7c3aeb9b4b688a01dade2ecf9ca61e",
    "m_Title": "1 \u00b7 Brillo",
    "m_Content": "Pasamos la imagen a un solo valor de brillo (0..1).",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 0.0,
        "width": 380.0,
        "height": 206.0
    },
    "m_Group": {
        "m_Id": "b6d61ebe7ada49f8a0002314c88eca48"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "77e6f40dc08d8772013b20cd9c2cd87f",
    "m_Title": "2 \u00b7 Dithering",
    "m_Content": "El nodo Dither suma un patron fijo (Bayer) segun el pixel: los degradados se vuelven tramas.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 430.0,
        "width": 380.0,
        "height": 262.0
    },
    "m_Group": {
        "m_Id": "08d99acc217f74621a557173f9670513"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "8bfeb3c33ad05dbf16b3b480808aa864",
    "m_Title": "3 \u00b7 Elegir 1 de 4 colores",
    "m_Content": "idx = floor(brillo*3.999) -> 0,1,2,3. Los Step + Lerp en cadena escogen la paleta.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 890.0,
        "width": 380.0,
        "height": 234.0
    },
    "m_Group": {
        "m_Id": "1c642031439908de0851f230955a3e7e"
    }
}

