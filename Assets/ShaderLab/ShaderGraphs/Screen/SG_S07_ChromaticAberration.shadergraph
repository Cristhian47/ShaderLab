{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "df9685b6cd60e267357fdeafd47972d7",
    "m_Title": "Como leer este grafo",
    "m_Content": "Pulsa A para ver todo el grafo (F centra la seleccion).\nLos datos viajan de IZQUIERDA a DERECHA hasta el Master Stack (a la derecha del todo).\nCada recuadro numerado es un PASO; la nota amarilla de su izquierda lo explica.\nLos circulos/cuadros dentro de los nodos son vistas previas del valor en ese punto.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -330.0,
        "y": -540.0,
        "width": 700.0,
        "height": 330.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "cb6ec90065f78512ff2a4e12647d96a8",
    "m_Title": "1 \u00b7 Direccion desde el centro",
    "m_Content": "uv - 0.5 apunta hacia afuera. Mas lejos del centro, mayor separacion.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 0.0,
        "width": 380.0,
        "height": 234.0
    },
    "m_Group": {
        "m_Id": "680f93de383e064f2de7b1ad9a6639c4"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "08c85f96ee5a198aa3cfe27280ca80e9",
    "m_Title": "2 \u00b7 Cantidad con pulso",
    "m_Content": "amount * (1 + pulso*sin(tiempo)).",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 364.0,
        "width": 380.0,
        "height": 206.0
    },
    "m_Group": {
        "m_Id": "68025df35e7ef048dfcf42938626e300"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "a9122d825b4d87b98ba7c27651eec05f",
    "m_Title": "3 \u00b7 Tres lecturas",
    "m_Content": "Rojo se lee un poco hacia afuera, verde en su sitio, azul hacia adentro.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 1094.0,
        "width": 380.0,
        "height": 234.0
    },
    "m_Group": {
