{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "3cee327dac3b41f1cb7d55f9c6b1ad44",
    "m_Title": "Como leer este grafo",
    "m_Content": "Pulsa A para ver todo el grafo (F centra la seleccion).\nLos datos viajan de IZQUIERDA a DERECHA hasta el Master Stack (a la derecha del todo).\nCada recuadro numerado es un PASO; la nota amarilla de su izquierda lo explica.\nLos circulos/cuadros dentro de los nodos son vistas previas del valor en ese punto.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -330.0,
        "y": -540.0,
        "width": 700.0,
        "height": 330.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "dee8908ba6187519b6e622986d74bcad",
    "m_Title": "1 \u00b7 Leer la pantalla",
    "m_Content": "URP Sample Buffer (Blit Source) = la imagen que la camara ya dibujo. Su UV es Screen Position.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 0.0,
        "width": 380.0,
        "height": 262.0
    },
    "m_Group": {
        "m_Id": "fe9e400b2f057b7297a4feade847f6da"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "bb640caaa9e12c35d2b17c9e23d699ca",
    "m_Title": "2 \u00b7 Luminancia",
    "m_Content": "Un gris 'correcto' pesa mas el verde (el ojo es mas sensible): dot(color, (0.21, 0.72, 0.07)).",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 392.0,
        "width": 380.0,
        "height": 262.0
    },
    "m_Group": {
        "m_Id": "6e4759d2e215e3df4c9a0f14a9c77ab4"
    }
}

