{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "4e064fcd2b7a93cd2c57aeb77cff01a0",
    "m_Title": "Como leer este grafo",
    "m_Content": "Pulsa A para ver todo el grafo (F centra la seleccion).\nLos datos viajan de IZQUIERDA a DERECHA hasta el Master Stack (a la derecha del todo).\nCada recuadro numerado es un PASO; la nota amarilla de su izquierda lo explica.\nLos circulos/cuadros dentro de los nodos son vistas previas del valor en ese punto.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -330.0,
        "y": -540.0,
        "width": 700.0,
        "height": 330.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "7cc7e9ce98f3bc6cf51fac80e09435da",
    "m_Title": "2 \u00b7 Matriz sepia",
    "m_Content": "Cada canal nuevo = combinacion de R,G,B originales. 3 Dot Product con 3 vectores = una matriz de color.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 280.0,
        "width": 380.0,
        "height": 262.0
    },
    "m_Group": {
        "m_Id": "cb24849d3ab782ef1e8508c2d5bfba59"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "d7fb91995f139cf154e272db22e85a6c",
    "m_Title": "3 \u00b7 Bordes oscuros",
    "m_Content": "Distancia al centro al cuadrado: dot(d,d). Crece hacia las esquinas.",
    "m_TextSize": 1,
