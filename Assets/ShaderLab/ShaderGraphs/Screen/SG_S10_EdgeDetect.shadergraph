{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "6d3b937b7ebc6a08f9563bc8a75ffa0e",
    "m_Title": "Como leer este grafo",
    "m_Content": "Pulsa A para ver todo el grafo (F centra la seleccion).\nLos datos viajan de IZQUIERDA a DERECHA hasta el Master Stack (a la derecha del todo).\nCada recuadro numerado es un PASO; la nota amarilla de su izquierda lo explica.\nLos circulos/cuadros dentro de los nodos son vistas previas del valor en ese punto.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -330.0,
        "y": -540.0,
        "width": 700.0,
        "height": 330.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "83cb5bc2b37ba4993253494c1cf670dd",
    "m_Title": "1 \u00b7 Pixel vecino",
    "m_Content": "texel = grosor / tamano de pantalla.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 0.0,
        "width": 380.0,
        "height": 206.0
    },
    "m_Group": {
        "m_Id": "94fdb807495f4c07426e5ac6f4db70f8"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "e6517c0329c46c58079ab89125ebce8e",
    "m_Title": "2 \u00b7 Brillo de los 8 vecinos",
    "m_Content": "Leemos los 8 pixeles que rodean al actual y convertimos cada uno a brillo.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 580.0,
        "width": 380.0,
        "height": 234.0
    },
    "m_Group": {
        "m_Id": "115531f76c79a8fa7e942aa4e52d886c"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "3c528266ce03211effa65730ceffe68a",
    "m_Title": "3 \u00b7 Sobel",
    "m_Content": "Dos filtros (horizontal y vertical) restan un lado del otro. Donde hay un cambio brusco de brillo, el resultado es grande.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 2060.0,
        "width": 380.0,
        "height": 290.0
    },
    "m_Group": {
        "m_Id": "08c53fcb3de4d9453771e618e57e33a2"
    }
}

{
