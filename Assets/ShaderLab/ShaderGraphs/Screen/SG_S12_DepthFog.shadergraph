{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "6262e8d3dc958511539dcab35fcac993",
    "m_Title": "Como leer este grafo",
    "m_Content": "Pulsa A para ver todo el grafo (F centra la seleccion).\nLos datos viajan de IZQUIERDA a DERECHA hasta el Master Stack (a la derecha del todo).\nCada recuadro numerado es un PASO; la nota amarilla de su izquierda lo explica.\nLos circulos/cuadros dentro de los nodos son vistas previas del valor en ese punto.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -330.0,
        "y": -540.0,
        "width": 700.0,
        "height": 330.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "f416379e54f6e0bd140f1f8ab71caf19",
    "m_Title": "1 \u00b7 Distancia por pixel",
    "m_Content": "Scene Depth (Eye) = distancia en METROS entre la camara y lo que hay en cada pixel.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 0.0,
        "width": 380.0,
        "height": 234.0
    },
    "m_Group": {
        "m_Id": "90982ef3af2c38563891f9238a05b198"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "125efb14114b8d5c44ff5c017ba83685",
    "m_Title": "2 \u00b7 Cantidad de niebla",
    "m_Content": "(distancia - inicio) / (fin - inicio), limitado a 0..1, por la densidad.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 460.0,
        "width": 380.0,
        "height": 234.0
    },
    "m_Group": {
