{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "7f11ec27aaede5a938e796f41ac00a7a",
    "m_Title": "Como leer este grafo",
    "m_Content": "Pulsa A para ver todo el grafo (F centra la seleccion).\nLos datos viajan de IZQUIERDA a DERECHA hasta el Master Stack (a la derecha del todo).\nCada recuadro numerado es un PASO; la nota amarilla de su izquierda lo explica.\nLos circulos/cuadros dentro de los nodos son vistas previas del valor en ese punto.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -330.0,
        "y": -540.0,
        "width": 700.0,
        "height": 330.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "f7ee6246c362855b46aed10f5402f27e",
    "m_Title": "1 \u00b7 Tamano de un pixel",
    "m_Content": "texel = 1 / tamano de pantalla. Es la distancia entre dos pixeles vecinos en UV.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 0.0,
        "width": 380.0,
        "height": 234.0
    },
    "m_Group": {
        "m_Id": "712d42384970fc8c112dfbd36ce80c0f"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "dfe691e3ece441318ec82bdfdd8a4722",
    "m_Title": "2 \u00b7 Anillo interior (3x3)",
    "m_Content": "Promediamos 9 lecturas alrededor del pixel. El centro pesa mas (4), los lados 2, las esquinas 1.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 460.0,
        "width": 380.0,
        "height": 262.0
    },
    "m_Group": {
        "m_Id": "3c477c622a1907843fc0ef35f3713fe5"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "6d2d33c28b30934865c29218c53e53cc",
    "m_Title": "3 \u00b7 Anillo exterior",
    "m_Content": "Mismo patron al doble de distancia: blur mas ancho con pocas lecturas.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
