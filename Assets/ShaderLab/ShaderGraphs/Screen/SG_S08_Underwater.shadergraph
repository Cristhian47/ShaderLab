{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "f02714ac4417bd39c9bd13c5eb53a90d",
    "m_Title": "Como leer este grafo",
    "m_Content": "Pulsa A para ver todo el grafo (F centra la seleccion).\nLos datos viajan de IZQUIERDA a DERECHA hasta el Master Stack (a la derecha del todo).\nCada recuadro numerado es un PASO; la nota amarilla de su izquierda lo explica.\nLos circulos/cuadros dentro de los nodos son vistas previas del valor en ese punto.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -330.0,
        "y": -540.0,
        "width": 700.0,
        "height": 330.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "5893164ce2acb291cbc50ea766291939",
    "m_Title": "1 \u00b7 Ondas en las UV",
    "m_Content": "offset = (sin(y*frec + t), cos(x*frec*1.3 + t*1.2)) * fuerza. Movemos DONDE leemos, no el color.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 0.0,
        "width": 380.0,
        "height": 262.0
    },
    "m_Group": {
        "m_Id": "32d7a0b29629d9c2f48832f15c1d500c"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "4793c959476de36aee75f9cdf776a2f0",
    "m_Title": "3 \u00b7 Tinte azul",
    "m_Content": "Multiplicar por el color del agua. Los bordes se oscurecen mas.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 1160.0,
        "width": 380.0,
        "height": 234.0
    },
    "m_Group": {
        "m_Id": "3567eef5692854162bbba503cb79b6e4"
    }
}

