{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "b3046298d050eb7a0380fcf937d22d19",
    "m_Title": "Como leer este grafo",
    "m_Content": "Pulsa A para ver todo el grafo (F centra la seleccion).\nLos datos viajan de IZQUIERDA a DERECHA hasta el Master Stack (a la derecha del todo).\nCada recuadro numerado es un PASO; la nota amarilla de su izquierda lo explica.\nLos circulos/cuadros dentro de los nodos son vistas previas del valor en ese punto.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -330.0,
        "y": -540.0,
        "width": 700.0,
        "height": 330.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "f320c495448179b5504519fa961ac676",
    "m_Title": "1 \u00b7 Cuantas celdas",
    "m_Content": "Pantalla (ancho,alto) / tamano del pixel = cuantos 'pixeles grandes' caben.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 0.0,
        "width": 380.0,
        "height": 234.0
    },
    "m_Group": {
        "m_Id": "fe55c5360860e40091002c1495a58c7c"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "95b3082570c4a3043cecddb52f8eb8d6",
    "m_Title": "2 \u00b7 Centro de cada celda",
    "m_Content": "floor(uv*celdas) elige la celda; +0.5 va al centro; / celdas vuelve a 0..1.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 460.0,
        "width": 380.0,
        "height": 234.0
    },
    "m_Group": {
        "m_Id": "379a811bb4a3f2b45416d972995f05b7"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "0f9f7b68d16a2f30c538ad91ec08a7dc",
    "m_Title": "3 \u00b7 Leer ese punto",
    "m_Content": "Todos los pixeles de una celda leen el MISMO punto -> bloques.",
    "m_TextSize": 1,
    "m_Theme": 0,
