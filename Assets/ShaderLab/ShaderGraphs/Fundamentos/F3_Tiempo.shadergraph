{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "d9c657818ce3c2ed6ce27d0fbb88830d",
    "m_Title": "Como leer este grafo",
    "m_Content": "Pulsa A para ver todo el grafo (F centra la seleccion).\nLos datos viajan de IZQUIERDA a DERECHA hasta el Master Stack (a la derecha del todo).\nCada recuadro numerado es un PASO; la nota amarilla de su izquierda lo explica.\nLos circulos/cuadros dentro de los nodos son vistas previas del valor en ese punto.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -330.0,
        "y": -540.0,
        "width": 700.0,
        "height": 330.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "c15686a5258dd8d984da377a348efb1b",
    "m_Title": "Tiempo",
    "m_Content": "El nodo Time entrega segundos desde que arranco el juego. Sine Time ya viene como seno.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 0.0,
        "width": 380.0,
        "height": 262.0
    },
    "m_Group": {
        "m_Id": "690c6ff79f6d2725c0ad29a71ffc5cb4"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "e516e91a9694180d017a140abae02b50",
    "m_Title": "Onda 0..1",
    "m_Content": "Un seno va de -1 a 1; lo llevamos a 0..1 con (seno*0.5 + 0.5) para usarlo como mezcla.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 0.0,
        "width": 380.0,
        "height": 262.0
    },
    "m_Group": {
        "m_Id": "7b5a4c23f3e5e6e779fd83e6afebe5ac"
    }
}

