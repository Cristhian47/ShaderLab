{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "664c434a6b0fe333a0bd553a4e9b6ea1",
    "m_Title": "Como leer este grafo",
    "m_Content": "Pulsa A para ver todo el grafo (F centra la seleccion).\nLos datos viajan de IZQUIERDA a DERECHA hasta el Master Stack (a la derecha del todo).\nCada recuadro numerado es un PASO; la nota amarilla de su izquierda lo explica.\nLos circulos/cuadros dentro de los nodos son vistas previas del valor en ese punto.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -330.0,
        "y": -540.0,
        "width": 700.0,
        "height": 330.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "12900b77841c4a7d52301df3c0d01cb4",
    "m_Title": "V1 \u00b7 Temblor",
    "m_Content": "VERTEX: cada vertice se mueve a lo largo de su normal con un seno*seno.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 0.0,
        "width": 380.0,
        "height": 234.0
    },
    "m_Group": {
        "m_Id": "a524f070dd81e88eff16fb426f48da9a"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "670da251a955fe3154e9c4c732a9e298",
    "m_Title": "V2 \u00b7 Aplastar y estirar",
    "m_Content": "Escala Y por (1+s) y XZ por (1-s/2): como 'respirar' manteniendo el volumen.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 1030.0,
        "width": 380.0,
        "height": 234.0
    },
    "m_Group": {
