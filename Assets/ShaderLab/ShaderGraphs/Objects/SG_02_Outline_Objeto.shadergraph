{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "362bb542059ce960cf21e8dac709bcc6",
    "m_Title": "Como leer este grafo",
    "m_Content": "Pulsa A para ver todo el grafo (F centra la seleccion).\nLos datos viajan de IZQUIERDA a DERECHA hasta el Master Stack (a la derecha del todo).\nCada recuadro numerado es un PASO; la nota amarilla de su izquierda lo explica.\nLos circulos/cuadros dentro de los nodos son vistas previas del valor en ese punto.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -330.0,
        "y": -540.0,
        "width": 700.0,
        "height": 330.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "097beebc2f648cb72ae8fe6b39fba875",
    "m_Title": "Objeto normal",
    "m_Content": "Material 1: un Lit sencillo. El contorno lo dibuja OTRO material (SG_02_Outline_Contorno). Las 3 propiedades del contorno estan aqui SOLO para editarlas desde los sliders del museo: este grafo no las usa, se las pasa al material del contorno.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 0.0,
        "width": 380.0,
        "height": 402.0
    },
    "m_Group": {
        "m_Id": "39abc8e11ccb88dc76a8f447cf23fc71"
    }
}

