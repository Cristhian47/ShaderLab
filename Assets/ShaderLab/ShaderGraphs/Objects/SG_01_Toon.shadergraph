{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "3d59559ac8f95a9ac74d85a3b282306a",
    "m_Title": "Como leer este grafo",
    "m_Content": "Pulsa A para ver todo el grafo (F centra la seleccion).\nLos datos viajan de IZQUIERDA a DERECHA hasta el Master Stack (a la derecha del todo).\nCada recuadro numerado es un PASO; la nota amarilla de su izquierda lo explica.\nLos circulos/cuadros dentro de los nodos son vistas previas del valor en ese punto.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -330.0,
        "y": -540.0,
        "width": 700.0,
        "height": 330.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "637a9211964d25cb7b29b5795ea8b9a7",
    "m_Title": "1 \u00b7 Datos de luz",
    "m_Content": "Custom Function: lee la luz principal de URP. Es el UNICO codigo del grafo.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 0.0,
        "width": 380.0,
        "height": 234.0
    },
    "m_Group": {
        "m_Id": "df0aa3b240c86b6a9b1ad9ea83446e96"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "00ef84411ce599b246a8d65eebc45005",
    "m_Title": "2 \u00b7 Luz en bandas",
    "m_Content": "N.L (cuanto mira la superficie a la luz) se 'escalona': ceil(x*pasos)/pasos.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 364.0,
        "width": 380.0,
        "height": 234.0
    },
    "m_Group": {
        "m_Id": "9e2bf9a8aa18acd3c5092ed5af9af37f"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "2a903ffc01355c9212e8f028b081e9d2",
    "m_Title": "3 \u00b7 Brillo especular",
    "m_Content": "Blinn-Phong: N.H elevado a 64, luego Step lo convierte en un circulo duro.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 1274.0,
        "width": 380.0,
        "height": 234.0
    },
    "m_Group": {
        "m_Id": "2323af71d0270662daabb3431ff3fa56"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "dd401ae41e6b6647d76cd0a29fb5cb6f",
    "m_Title": "4 \u00b7 Luz de borde",
    "m_Content": "(1 - N.V) detecta el borde; se multiplica por la luz para que solo salga del lado iluminado.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
