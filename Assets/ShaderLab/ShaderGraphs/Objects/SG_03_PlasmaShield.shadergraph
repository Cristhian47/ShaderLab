{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "106f75388f090918c183f48a3ead3967",
    "m_Title": "Como leer este grafo",
    "m_Content": "Pulsa A para ver todo el grafo (F centra la seleccion).\nLos datos viajan de IZQUIERDA a DERECHA hasta el Master Stack (a la derecha del todo).\nCada recuadro numerado es un PASO; la nota amarilla de su izquierda lo explica.\nLos circulos/cuadros dentro de los nodos son vistas previas del valor en ese punto.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -330.0,
        "y": -540.0,
        "width": 700.0,
        "height": 330.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "f55f21e004bb15269174e640da4d5a85",
    "m_Title": "1 \u00b7 Borde brillante",
    "m_Content": "Fresnel: el escudo brilla mas en el contorno.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 0.0,
        "width": 380.0,
        "height": 206.0
    },
    "m_Group": {
        "m_Id": "e95907bcb5223600e842c1c794f72ae9"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "685879006e73556a646ffa7711df6d0f",
    "m_Title": "2 \u00b7 Plasma que fluye",
    "m_Content": "Ruido que sube con el tiempo. Gradient Noise 2D evaluado en dos planos (XY y ZY) imita un ruido 3D.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 460.0,
        "width": 380.0,
        "height": 262.0
    },
    "m_Group": {
        "m_Id": "6c8b689c770d58767106a69578b72254"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "a352851b35f694e5768ed89ad9370fcc",
    "m_Title": "3 \u00b7 Venas",
    "m_Content": "|2n - 1| vale 0 donde n=0.5: eso dibuja lineas finas. Se invierte y se afila con Power.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 1190.0,
        "width": 380.0,
        "height": 262.0
    },
    "m_Group": {
