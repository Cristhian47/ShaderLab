    "m_ObjectId": "b07d64d59e72a1771d8837ef1b8eeaae",
    "m_Title": "2 \u00b7 Lineas de escaneo",
    "m_Content": "sin(altura*densidad - tiempo*velocidad) -> smoothstep para lineas definidas.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
