{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "730d7b568f3147b04621e58bc048ee9d",
    "m_Title": "Como leer este grafo",
    "m_Content": "Pulsa A para ver todo el grafo (F centra la seleccion).\nLos datos viajan de IZQUIERDA a DERECHA hasta el Master Stack (a la derecha del todo).\nCada recuadro numerado es un PASO; la nota amarilla de su izquierda lo explica.\nLos circulos/cuadros dentro de los nodos son vistas previas del valor en ese punto.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -330.0,
        "y": -540.0,
        "width": 700.0,
        "height": 330.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "ba9861b97bba3acfaf51d40e734b291b",
    "m_Title": "1 \u00b7 Nivel del liquido",
    "m_Content": "El nivel va de abajo (-0.5) a arriba (+0.5) de la esfera. Fill 0..1 se remapea a ese rango.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 0.0,
        "width": 380.0,
        "height": 262.0
    },
    "m_Group": {
        "m_Id": "cf3354b5bc6e58892125dec3196afbf3"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "bd2d77e0f7c1b2ecc28dc97c934f247e",
    "m_Title": "2 \u00b7 Oleaje de la superficie",
    "m_Content": "Dos senos (uno segun X, otro segun Z) desplazan la altura de la superficie.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 580.0,
        "width": 380.0,
        "height": 234.0
    },
    "m_Group": {
        "m_Id": "56945d880c94b36f266bff8ee7640cb1"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "89861a25558b0612ef7e00ab27e1a4dd",
    "m_Title": "3 \u00b7 Recortar (Alpha Clip)",
    "m_Content": "Si el punto esta POR ENCIMA de la superficie, Alpha=0 y se descarta. Threshold 0.5.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -430.0,
        "y": 1310.0,
        "width": 380.0,
        "height": 234.0
    },
    "m_Group": {
        "m_Id": "09b202f87193c768e91c0cdafdbf0f6c"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "4740a34ddba9b1e27b808fff2f0348a3",
    "m_Title": "4 \u00b7 Color del liquido",
    "m_Content": "Gradiente fondo->superficie + brillo de borde (Fresnel) + tapa brillante en el corte.",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
